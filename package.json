{
  "name": "@zairosoft/workless",
  "version": "1.0.0",
  "description": "An AI platform that reduces workload and enables you to work faster, easier, and more efficiently.",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev": "tailwindcss -i ./public/assets/css/app.css -o ./public/assets/css/tailwindcss.css --minify && concurrently --kill-others --names vite,nest \"vite\" \"ts-node-dev --respawn --transpile-only src/main.ts\"",
    "db:platform": "ts-node src/database/migration.runner.ts migrate",
    "db:migrate": "ts-node src/database/migration.runner.ts migrate",
    "db:migrate:status": "ts-node src/database/migration.runner.ts status",
    "db:migrate:revert": "ts-node src/database/migration.runner.ts revert",
    "seed": "ts-node src/database/seeder.runner.ts",
    "module:create": "ts-node src/workless/lifecycle/module-create.runner.ts",
    "module:delete": "ts-node src/workless/lifecycle/module-delete.runner.ts",
    "module:list": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts list",
    "module:install": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts install",
    "module:upgrade": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts upgrade",
    "module:migrate": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts migrate",
    "module:migrate:status": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts migration:status",
    "module:migrate:revert": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts migration:revert",
    "module:seed": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts seed",
    "module:uninstall": "ts-node src/workless/lifecycle/module-lifecycle.runner.ts uninstall",
    "test": "echo \"No tests configured yet\" && exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "alpinejs": "^3.16.3",
    "argon2": "^0.45.1",
    "bullmq": "^5.70.4",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "html-minifier": "^4.0.0",
    "html-minifier-terser": "^7.2.0",
    "ioredis": "^5.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/html-minifier": "^4.0.6",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^25.3.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.2"
  }
}
